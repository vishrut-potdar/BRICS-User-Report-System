# Copy to .env and fill in. Never commit .env.

# Language layer: gemini | offline (offline = keyword stub, no translation; dev/tests only)
LANGUAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage: local (JSONL file) | memory | firestore
REPOSITORY=local
LOCAL_STORE_PATH=data/store/requests.jsonl
FIRESTORE_COLLECTION=requests
# GOOGLE_CLOUD_PROJECT=

# Long random string. Phone numbers are stored only as HMAC hashes with this salt.
PHONE_HASH_SALT=

# Optional: better geocoding of landmarks (confidence B). Without it, district-name matching only.
GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Telegram fallback channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

PACK_ID=IN-MH
CORS_ORIGINS=*
EXPORT_MIN_REQUESTERS=5
